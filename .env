# ============================================================================
# Custom Inference Engine — Global Configuration (.env)
# Change model, hardware, KV cache, or workload settings in this single file.
# ============================================================================

# --- Model & Hardware ---
ENGINE_MODEL_REPO=Qwen/Qwen2.5-7B-Instruct
# Leave ENGINE_MODEL_DIR empty to auto-derive from ENGINE_MODEL_REPO (e.g. ./qwen2.5-7b-instruct)
ENGINE_MODEL_DIR=
# "auto" selects "cuda" if available else "cpu"
ENGINE_DEVICE=auto
# "auto" selects "float16" on CUDA else "float32" (options: auto, float16, bfloat16, float32)
ENGINE_DTYPE=auto

# --- Paged KV Cache & Continuous Batching Scheduler ---
ENGINE_NUM_BLOCKS=512
ENGINE_BLOCK_SIZE=16
ENGINE_MAX_BATCH_SIZE=16
ENGINE_MAX_BATCHED_TOKENS=4096
ENGINE_MAX_MODEL_LEN=2048
ENGINE_ENABLE_PREFIX_CACHING=true
ENGINE_USE_CUDA_GRAPH=true
ENGINE_TEMPERATURE=0.0

# --- Live Traffic Monitor & Benchmark Defaults ---
ENGINE_TRACE_NUM_REQUESTS=60
ENGINE_TRACE_QPS=10.0
ENGINE_TRACE_MAX_NEW_TOKENS=48
ENGINE_TRACE_BURST_INITIAL=8
ENGINE_TRACE_STREAM_BYTES=1500000
ENGINE_BENCHMARK_NUM_REQUESTS=100
ENGINE_BENCHMARK_MAX_NEW_TOKENS=64

